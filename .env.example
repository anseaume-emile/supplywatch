# ---- General ------------------------------------------------------------------
# URL users open (used in links)
BASE_URL=https://supplywatch.internal
# Names/IPs Caddy serves over HTTPS (comma-separated); each gets a certificate from Caddy's own CA
HTTPS_HOSTS=supplywatch.internal, localhost
# The server's IP from HTTPS_HOSTS, if clients connect by IP (they send no name, so Caddy needs a default)
HTTPS_DEFAULT_SNI=
# Long random string; encrypts stored tokens. Generate: openssl rand -hex 32
SECRET_KEY=
CURRENCY=CHF
# ISO country for regional stock and pricing
COUNTRY=CH
TZ=Europe/Zurich
# SQLite in the /data volume by default. Postgres example:
# DATABASE_URL=postgresql+psycopg://sw:password@db:5432/supplywatch
DATABASE_URL=sqlite:////data/supplywatch.db

# ---- Access ---------------------------------------------------------------------
# none  = no login; everyone on the network can use everything (keep it on the LAN/VPN)
# proxy = trust the user email header from an SSO proxy (oauth2-proxy, Authelia, ...) later
AUTH_MODE=none
AUTH_USER_HEADER=X-Forwarded-Email
AUTH_GROUPS_HEADER=X-Forwarded-Groups
# Only used with AUTH_MODE=proxy
ADMIN_USERS=emile.anseaume@cdds.ai
ADMIN_GROUP=
# MCP server at <BASE_URL>/mcp for AI assistants (Claude, Cursor, ...). Off while empty.
# Clients send "Authorization: Bearer <token>"; the token allows reads AND changes. Generate: openssl rand -hex 32
MCP_TOKEN=

# ---- BOMs: git repositories with Altium projects ------------------------------
# Comma- or newline-separated. "url#branch" to pin a branch (default: remote default branch).
# Current CDDS projects live in Altium 365 version control (PRJ-00002, 00004, 00006, 00007):
GIT_REPOS=https://afs-vcs-eu1.365.altium.com/git/E0BE5494-6EBE-433F-9CE4-6E358AA4D017.git,https://afs-vcs-eu1.365.altium.com/git/B1C57C39-2665-417F-B7F6-2BCE7F6B4D36.git,https://afs-vcs-eu1.365.altium.com/git/0189FA49-4EB0-4C5B-98EB-E6F46BF0E67A.git,https://afs-vcs-eu1.365.altium.com/git/01F7D987-BBD8-424E-BAE9-62F71321ABD4.git
# HTTPS credentials. Altium 365 VCS: Altium account email + password (see README).
# GitHub: fine-grained PAT (Contents: read) with GIT_USERNAME empty. GitLab: deploy token + its username.
GIT_TOKEN=
GIT_USERNAME=
# SSH remotes instead: path of a read-only deploy key mounted into the container
GIT_SSH_KEY=
# Or/also: folders mounted into the container that contain Altium projects (e.g. a file share).
# Host folder mounted read-only at /projects by docker-compose.yml, e.g. Altium's local projects folder:
#   ALTIUM_PROJECTS_DIR=C:/Users/Public/Documents/Altium  and  PROJECT_DIRS=/projects
# A project found in several places is synced once, from the most recently saved copy.
ALTIUM_PROJECTS_DIR=
PROJECT_DIRS=
# Only .PrjPcb files whose name matches this regex are imported
PROJECT_FILTER=^PRJ-

# ---- Supply data (all free API keys) --------------------------------------------
# trustedparts.com → create account → My Account → API Keys (request, approved by ECIA)
TRUSTEDPARTS_COMPANY_ID=
TRUSTEDPARTS_API_KEY=
# developer.digikey.com → organisation → production app with Product Information v4
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=CH
DIGIKEY_LANGUAGE=en
# mouser.com/api-search → Search API key
MOUSER_API_KEY=
# partner.element14.com → register → key for the Product Search API
FARNELL_API_KEY=
FARNELL_STORE=ch.farnell.com

# ---- Schedule (crontab syntax in TZ, or "off") --------------------------------
# BOM sync (git pull + parse) every 30 min in working hours; each sync also refreshes new parts
BOM_SYNC_CRON=*/30 6-20 * * 1-5
# Full supply refresh daily
SUPPLY_REFRESH_CRON=30 5 * * *
# Parts refreshed within this many hours are skipped by "due" refreshes
SUPPLY_MAX_AGE_HOURS=20
# Also track alternate MPNs (2nd/3rd source)
INCLUDE_ALTERNATES=true

# ---- Risk thresholds ----------------------------------------------------------
LONG_LEAD_DAYS=84
LOW_STOCK_MULTIPLE=3

# ---- Optional, off by default: Nexar (Octopart data / Altium 365 BOMs) ----------
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
NEXAR_SUPPLY=false
NEXAR_LEAD_TIME=false
NEXAR_SPECS=false
NEXAR_MONTHLY_PART_BUDGET=1800
A365_WORKSPACE_URL=
A365_PROJECT_FILTER=
